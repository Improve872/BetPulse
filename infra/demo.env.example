# Puerto del frontend en la PC de la demo.
DEMO_PORT=3000

# Base de datos interna del compose (no se publica al host).
POSTGRES_DB=betpulse
POSTGRES_USER=betpulse
POSTGRES_PASSWORD=betpulse

# Admin sembrado al primer arranque.
ADMIN_EMAIL=admin@betpulse.local
ADMIN_PASSWORD=Admin123!
ADMIN_DISPLAY_NAME=Administrador

# Opcional: sube el rate limit de OpenDota.
OPENDOTA_API_KEY=

# Imágenes locales; se pueden cambiar por ghcr.io/usuario/... si se publican.
BACKEND_IMAGE=betpulse-backend:demo
FRONTEND_IMAGE=betpulse-frontend:demo
